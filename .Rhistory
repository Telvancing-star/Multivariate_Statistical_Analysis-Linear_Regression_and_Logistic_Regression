# =============================================================================
# 第二部分：参数估计与显著性检验
# =============================================================================
cat("\n=== 参数估计与显著性检验 ===\n")
library(glmnet)
library(MASS)
lm_model <- lm(Price ~ ., data = data_for_regression)
cat("   已完成普通最小二乘回归拟合\n")
n <- nrow(data_for_regression)
p <- length(coef(lm_model))
predictor_names <- names(data_for_regression)[names(data_for_regression) != "Price"]
cat("\n1. 回归系数的最小二乘估计与回归方程：\n")
coef_vector <- coef(lm_model)
coef_df <- data.frame(变量 = names(coef_vector), 系数估计 = round(coef_vector, 6))
print(coef_df, row.names = FALSE)
eq_terms <- paste0(round(coef_vector[-1], 4), " * ", predictor_names)
reg_eq <- paste("Price_hat =", round(coef_vector[1], 4), "+", paste(eq_terms, collapse = " + "))
cat("   回归方程：\n")
cat("   ", reg_eq, "\n")
residuals_lm <- resid(lm_model)
rss <- sum(residuals_lm^2)
sigma2_hat <- rss / lm_model$df.residual
cat(sprintf("\n2. 误差方差估计：σ^2 = %.4f (RSS = %.4f, 自由度 = %d)\n",
sigma2_hat, rss, lm_model$df.residual))
cat("\n3. 方差分析表：\n")
# 提取方差分析数据
anova_data <- anova(lm_model)
# 计算回归平方和、自由度和均方
ssr <- sum(anova_data$'Sum Sq'[-nrow(anova_data)])
dfr <- sum(anova_data$Df[-nrow(anova_data)])
msr <- ssr / dfr
# 计算误差平方和、自由度和均方
sse <- anova_data$'Sum Sq'[nrow(anova_data)]
dfe <- anova_data$Df[nrow(anova_data)]
mse <- sse / dfe
# 计算总平方和和总自由度
ss_total <- ssr + sse
df_total <- dfr + dfe
# 计算F统计量和p值
f_stat <- msr / mse
p_value <- pf(f_stat, dfr, dfe, lower.tail = FALSE)
# 创建符合用户要求的方差分析表
variance_table <- data.frame(
"方差来源" = c("回归(R)", "误差(E)", "总和(T)"),
"自由度" = c(dfr, dfe, df_total),
"平方和(SS)" = c(ssr, sse, ss_total),
"均方(MS)" = c(msr, mse, NA),
"F值" = c(f_stat, NA, NA),
"p值" = c(p_value, NA, NA)
)
# 格式化输出表格
print("表2.1 方差分析表")
print(format(variance_table, digits = 6, nsmall = 4, na.encode = FALSE), row.names = FALSE)
summary_lm <- summary(lm_model)
f_stat <- summary_lm$fstatistic
f_p_value <- pf(f_stat[1], f_stat[2], f_stat[3], lower.tail = FALSE)
cat(sprintf("\n4. 回归关系整体显著性检验：F(%d, %d) = %.4f, p-value = %.6g\n",
f_stat[2], f_stat[3], f_stat[1], f_p_value))
cat("\n5. 回归系数显著性与95%%置信区间：\n")
coef_table <- summary_lm$coefficients
ci_table <- confint(lm_model, level = 0.95)
coef_summary <- cbind(round(coef_table, 6), round(ci_table, 6))
colnames(coef_summary)[5:6] <- c("CI_2.5%", "CI_97.5%")
print(coef_summary)
# =============================================================================
# 第三部分：回归诊断
# =============================================================================
cat("\n=== 回归诊断 ===\n")
cat("\n1. 残差分析：\n")
studentized_residuals <- rstandard(lm_model)
old_par <- par(no.readonly = TRUE)
windowsFonts(微软雅黑 = windowsFont("微软雅黑"))
par(family = "微软雅黑")
# 创建QQ图并计算相关系数
qq_obj <- qqnorm(studentized_residuals,
main = "学生化残差的正态QQ图",
xlab = "理论分位数",
ylab = "样本分位数",
pch = 19,
col = "blue")
qqline(studentized_residuals, col = "red", lwd = 2)
# 提取QQ图中的理论分位数和样本分位数
theoretical_quantiles <- qq_obj$x
sample_quantiles <- qq_obj$y
# 计算理论分位数和样本分位数之间的相关系数
qq_correlation <- cor(theoretical_quantiles, sample_quantiles)
cat(sprintf("   QQ图相关性系数: r = %.4f\n", qq_correlation))
# Shapiro-Wilk正态性检验
shapiro_sample <- studentized_residuals
if (length(shapiro_sample) > 5000) {
set.seed(2025)
shapiro_sample <- sample(shapiro_sample, 5000)
cat("   样本量>5000，已抽样5000个残差用于Shapiro-Wilk检验\n")
}
shapiro_result <- shapiro.test(shapiro_sample)
cat(sprintf("   Shapiro-Wilk正态性检验: W = %.4f, p-value = %.6g\n",
shapiro_result$statistic, shapiro_result$p.value))
# 综合判断残差是否服从正态分布
cat("   正态分布结论：")
if (shapiro_result$p.value > 0.05 && qq_correlation > 0.99) {
cat("残差高度服从正态分布 (p > 0.05, r > 0.99)\n")
} else if (shapiro_result$p.value > 0.05 && qq_correlation > 0.95) {
cat("残差基本服从正态分布 (p > 0.05, r > 0.95)\n")
} else if (shapiro_result$p.value <= 0.05 && qq_correlation > 0.98) {
cat("残差近似服从正态分布 (p ≤ 0.05, r > 0.98)，轻微偏离\n")
} else {
cat("残差不服从正态分布 (p ≤ 0.05, r ≤ 0.98)，存在明显偏离\n")
}
hist(studentized_residuals,
breaks = "FD",
main = "学生化残差直方图",
xlab = "学生化残差",
ylab = "频数",
col = "lightblue",
border = "black")
lines(density(studentized_residuals, na.rm = TRUE), col = "red", lwd = 2)
cat("\n2. 残差图分析（线性性与方差齐性）：\n")
predicted_values <- predict(lm_model)
plot(predicted_values, studentized_residuals,
main = "学生化残差 vs 拟合值",
xlab = "拟合值",
ylab = "学生化残差",
pch = 19,
col = "purple")
abline(h = 0, col = "red", lwd = 2)
abline(h = c(-2, 2), col = "orange", lty = 2)
cat("   已绘制残差-拟合值图，辅助判断异方差与非线性\n")
sig_vars <- rownames(coef_table)[which(coef_table[, 4] < 0.05)]
sig_vars <- setdiff(sig_vars, "(Intercept)")
if (length(sig_vars) > 0) {
n_cols <- 3
n_rows <- ceiling(length(sig_vars) / n_cols)
par(mfrow = c(n_rows, n_cols))
par(mar = c(3.5, 3.5, 2, 1))
for (var in sig_vars) {
plot(data_for_regression[[var]], studentized_residuals,
main = paste("残差 vs", var),
xlab = var,
ylab = "学生化残差",
pch = 19,
col = "darkred")
abline(h = 0, col = "gray40", lwd = 1)
}
par(old_par)
}
cat("\n3. 影响性分析：\n")
leverage_vals <- hatvalues(lm_model)
leverage_threshold <- 2 * p / n
high_leverage_idx <- which(leverage_vals > leverage_threshold)
cat(sprintf("   杠杆统计量阈值: %.4f, 高杠杆点数量: %d\n",
leverage_threshold, length(high_leverage_idx)))
covratio_vals <- covratio(lm_model)
covratio_lower <- 1 - 3 * p / n
covratio_upper <- 1 + 3 * p / n
covratio_flags <- which(covratio_vals < covratio_lower | covratio_vals > covratio_upper)
cat(sprintf("   Covratio 判断区间: [%.4f, %.4f], 异常点数量: %d\n",
covratio_lower, covratio_upper, length(covratio_flags)))
influential_points <- sort(unique(c(high_leverage_idx, covratio_flags)))
if (length(influential_points) > 0) {
cat("   需要关注的影响性观测编号:\n")
print(head(influential_points, 20))
} else {
cat("   未检测到显著影响点\n")
}
plot(leverage_vals,
main = "杠杆值分布",
ylab = "Leverage",
xlab = "观测编号",
pch = 19,
col = "steelblue")
abline(h = leverage_threshold, col = "red", lty = 2)
plot(covratio_vals,
main = "Covratio分布",
ylab = "Covratio",
xlab = "观测编号",
pch = 19,
col = "darkgreen")
abline(h = c(covratio_lower, covratio_upper), col = "orange", lty = 2)
cat("\n4. 多重共线性分析（条件数方法）：\n")
x_matrix_scaled <- scale(data_for_regression[, predictor_names])
condition_number <- kappa(x_matrix_scaled, exact = TRUE)
cat(sprintf("   条件数 κ = %.4f\n", condition_number))
if (condition_number > 100) {
cat("   κ > 100，表明存在严重多重共线性\n")
} else if (condition_number > 30) {
cat("   30 < κ ≤ 100，表明存在明显多重共线性\n")
} else {
cat("   κ ≤ 30，多重共线性问题可接受\n")
}
# =============================================================================
# 第四部分：预测过程与性能评估
# =============================================================================
cat("\n=== 预测过程与性能评估 ===\n")
set.seed(456)
train_indices <- sample(seq_len(nrow(data_for_regression)), size = ceiling(0.7 * nrow(data_for_regression)))
train_data <- data_for_regression[train_indices, ]
test_data <- data_for_regression[-train_indices, ]
lm_train <- lm(Price ~ ., data = train_data)
test_pred <- predict(lm_train, newdata = test_data)
test_conf_int <- predict(lm_train, newdata = test_data, interval = "confidence", level = 0.95)
test_pred_int <- predict(lm_train, newdata = test_data, interval = "prediction", level = 0.95)
test_actual <- test_data$Price
cat("\n   测试集预测值点估计与区间估计（前10条）：\n")
prediction_summary <- data.frame(
实际值 = round(test_actual[seq_len(min(10, length(test_actual)))], 2),
点预测 = round(test_pred[seq_len(min(10, length(test_pred)))], 2),
置信下限 = round(test_conf_int[seq_len(min(10, nrow(test_conf_int))), "lwr"], 2),
置信上限 = round(test_conf_int[seq_len(min(10, nrow(test_conf_int))), "upr"], 2),
预测下限 = round(test_pred_int[seq_len(min(10, nrow(test_pred_int))), "lwr"], 2),
预测上限 = round(test_pred_int[seq_len(min(10, nrow(test_pred_int))), "upr"], 2)
)
print(prediction_summary, row.names = FALSE)
calc_metrics <- function(actual, pred) {
mse_val <- mean((pred - actual)^2)
rmse_val <- sqrt(mse_val)
mae_val <- mean(abs(pred - actual))
r2_val <- 1 - sum((pred - actual)^2) / sum((actual - mean(actual))^2)
data.frame(复决定系数 = round(r2_val, 4),
MSE = round(mse_val, 4),
RMSE = round(rmse_val, 4),
MAE = round(mae_val, 4))
}
train_metrics <- calc_metrics(train_data$Price, predict(lm_train, newdata = train_data))
test_metrics <- calc_metrics(test_actual, test_pred)
cat("   训练集性能指标：\n")
print(train_metrics, row.names = FALSE)
cat("\n   测试集性能指标：\n")
print(test_metrics, row.names = FALSE)
overall_r2 <- summary_lm$r.squared
overall_mae <- mean(abs(predicted_values - data_for_regression$Price))
overall_mse <- mean((predicted_values - data_for_regression$Price)^2)
cat(sprintf("\n   全量样本：R² = %.4f, MSE = %.4f, MAE = %.4f\n",
overall_r2, overall_mse, overall_mae))
# =============================================================================
# 第五部分：模型改进策略
# =============================================================================
cat("\n=== 模型改进 ===\n")
needs_boxcox <- !is.na(shapiro_result$p.value) && shapiro_result$p.value < 0.05
needs_influence_removal <- length(influential_points) > 0
needs_ridge <- condition_number > 30
improved_df <- data_for_regression
improved_df$Response_for_model <- improved_df$Price
response_label <- "Price"
lambda_opt <- NA
if (needs_boxcox) {
cat("\n1. 残差正态性未通过，执行Box-Cox变换：\n")
lambda_seq <- seq(-2, 2, by = 0.1)
boxcox_result <- boxcox(lm_model, lambda = lambda_seq, plotit = TRUE,
main = "Box-Cox λ选择图")
lambda_opt <- boxcox_result$x[which.max(boxcox_result$y)]
cat(sprintf("   Box-Cox最优λ = %.3f\n", lambda_opt))
if (abs(lambda_opt) < 1e-6) {
improved_df$Response_for_model <- log(improved_df$Price)
response_label <- "log(Price)"
cat("   采用对数变换（λ ≈ 0）\n")
} else {
improved_df$Response_for_model <- (improved_df$Price^lambda_opt - 1) / lambda_opt
response_label <- sprintf("BoxCox(Price, λ=%.2f)", lambda_opt)
}
} else {
cat("\n1. 残差正态性可接受，暂不进行Box-Cox变换\n")
}
if (needs_influence_removal) {
cat("\n2. 检测到影响性观测，执行剔除：\n")
improved_df <- improved_df[-influential_points, ]
cat(sprintf("   已剔除 %d 个观测，剩余样本量: %d\n",
length(influential_points), nrow(improved_df)))
} else {
cat("\n2. 未检测到显著影响点，无需剔除\n")
}
model_data_final <- improved_df[, c("Response_for_model", predictor_names)]
colnames(model_data_final)[1] <- "Y_improved"
improved_lm_model <- lm(Y_improved ~ ., data = model_data_final)
cat("\n3. 改进后普通回归模型结果：\n")
print(summary(improved_lm_model)$coefficients)
if (!is.na(lambda_opt)) {
cat(sprintf("   该模型的因变量为 %s\n", response_label))
}
if (needs_ridge) {
cat("\n4. 条件数提示复共线性，需要实施岭回归：\n")
x_improved <- as.matrix(model_data_final[, -1])
y_improved <- model_data_final$Y_improved
set.seed(123)
cv_ridge <- cv.glmnet(x_improved, y_improved, alpha = 0, nfolds = 10)
lambda_min <- cv_ridge$lambda.min
lambda_1se <- cv_ridge$lambda.1se
cat(sprintf("   λ.min = %.6f, λ.1se = %.6f\n", lambda_min, lambda_1se))
ridge_model_min <- glmnet(x_improved, y_improved, alpha = 0, lambda = lambda_min)
ridge_coef <- as.matrix(coef(ridge_model_min))
cat("   岭回归系数（λ.min）：\n")
print(round(ridge_coef, 5))
ridge_pred <- predict(ridge_model_min, newx = x_improved)
ridge_mse <- mean((ridge_pred - y_improved)^2)
ridge_mae <- mean(abs(ridge_pred - y_improved))
ridge_r2 <- 1 - sum((ridge_pred - y_improved)^2) / sum((y_improved - mean(y_improved))^2)
cat(sprintf("   改进后岭回归性能：R² = %.4f, MSE = %.4f, MAE = %.4f\n",
ridge_r2, ridge_mse, ridge_mae))
} else {
cat("\n4. 条件数无明显异常，无需岭回归\n")
}
cat("\n=== 模型优化步骤完成，以上即五大部分的详细结果 ===\n")
